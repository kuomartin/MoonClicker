{
  "name": "moonclicker-script-workbench",
  "displayName": "MoonClicker Script Workbench",
  "description": "Connect VS Code to a MoonClicker device running Script Workbench.",
  "version": "0.1.0",
  "publisher": "kuomartin",
  "repository": {
    "type": "git",
    "url": "https://github.com/kuomartin/MoonClicker.git",
    "directory": "vscode-extension"
  },
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "moonclicker.connect",
        "title": "MoonClicker: Connect to Device",
        "icon": "$(plug)"
      },
      {
        "command": "moonclicker.disconnect",
        "title": "MoonClicker: Disconnect from Device"
      },
      {
        "command": "moonclicker.openScript",
        "title": "MoonClicker: Open Script from Device"
      },
      {
        "command": "moonclicker.run",
        "title": "MoonClicker: Run Current Script on Device"
      },
      {
        "command": "moonclicker.openMirror",
        "title": "MoonClicker: Open Realtime Mirror"
      },
      {
        "command": "moonclicker.runRemote",
        "title": "MoonClicker: Run Remote Script"
      },
      {
        "command": "moonclicker.setupStubs",
        "title": "MoonClicker: Setup Lua Stubs",
        "icon": "$(lightbulb)"
      },
      {
        "command": "moonclicker.toggleMirror",
        "title": "MoonClicker: Toggle Display Mirror"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "moonclicker.connect",
          "when": "view == moonclicker.workspace",
          "group": "navigation"
        },
        {
          "command": "moonclicker.setupStubs",
          "when": "view == moonclicker.workspace",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "moonclicker.runRemote",
          "when": "viewItem == remoteScript"
        },
        {
          "command": "moonclicker.openMirror",
          "when": "viewItem == remoteRoot"
        },
        {
          "command": "moonclicker.disconnect",
          "when": "viewItem == remoteRoot"
        }
      ]
    },
    "keybindings": [
      {
        "command": "moonclicker.run",
        "key": "F5",
        "when": "editorFocus && resourceLangId == lua && resourceFilename == main.lua"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "moonclicker-scripts",
          "title": "MoonClicker Scripts",
          "icon": "$(device-mobile)"
        }
      ]
    },
    "views": {
      "moonclicker-scripts": [
        {
          "id": "moonclicker.workspace",
          "name": "Workspace"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package-build",
    "package-build": "npm run compile && esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --minify && cp node_modules/jmuxer/dist/jmuxer.min.js dist/jmuxer.min.js",
    "generate": "buf generate ../proto",
    "precompile": "npm run generate",
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "pretest": "npm run compile",
    "test": "node --test out/test/**/*.test.js",
    "test:client": "node scripts/test-server.mjs",
    "package": "vsce package"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.73.0",
    "@bufbuild/protoc-gen-es": "^2.15.0",
    "@types/adm-zip": "^0.5.0",
    "@types/multicast-dns": "^7.2.4",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@types/ws": "^8.5.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.23.0",
    "multicast-dns": "^7.2.5",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.15.0",
    "adm-zip": "^0.6.1",
    "jmuxer": "^2.1.4",
    "ws": "^8.18.0"
  },
  "allowScripts": {
    "@bufbuild/buf@1.73.0": true
  }
}
