{
  "name": "moonclicker-script-workbench",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.3.0",
  "publisher": "kuomartin",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/kuomartin/MoonClicker.git",
    "directory": "vscode-extension"
  },
  "homepage": "https://github.com/kuomartin/MoonClicker/blob/master/docs/extension.md",
  "bugs": {
    "url": "https://github.com/kuomartin/MoonClicker/issues"
  },
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "android",
    "automation",
    "lua",
    "moonclicker",
    "scripting"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "moonclicker.connect",
        "title": "%command.connect%",
        "icon": "$(plug)"
      },
      {
        "command": "moonclicker.disconnect",
        "title": "%command.disconnect%",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "moonclicker.openScript",
        "title": "%command.openScript%"
      },
      {
        "command": "moonclicker.newScript",
        "title": "%command.newScript%",
        "icon": "$(new-file)"
      },
      {
        "command": "moonclicker.run",
        "title": "%command.run%"
      },
      {
        "command": "moonclicker.stop",
        "title": "%command.stop%",
        "icon": "$(debug-stop)"
      },
      {
        "command": "moonclicker.openWorkbench",
        "title": "%command.openWorkbench%",
        "icon": "$(device-camera-video)"
      },
      {
        "command": "moonclicker.runRemote",
        "title": "%command.runRemote%",
        "icon": "$(play)"
      },
      {
        "command": "moonclicker.refresh",
        "title": "%command.refresh%",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "moonclicker.connect",
          "when": "view == moonclicker.workspace && !moonclicker.connected",
          "group": "navigation"
        },
        {
          "command": "moonclicker.newScript",
          "when": "view == moonclicker.workspace && moonclicker.connected",
          "group": "navigation@1"
        },
        {
          "command": "moonclicker.openWorkbench",
          "when": "view == moonclicker.workspace && moonclicker.connected",
          "group": "navigation@2"
        },
        {
          "command": "moonclicker.refresh",
          "when": "view == moonclicker.workspace && moonclicker.connected",
          "group": "navigation@3"
        },
        {
          "command": "moonclicker.disconnect",
          "when": "view == moonclicker.workspace && moonclicker.connected",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "moonclicker.runRemote",
          "when": "viewItem == remoteScript",
          "group": "inline"
        },
        {
          "command": "moonclicker.stop",
          "when": "viewItem == remoteScriptRunning",
          "group": "inline"
        },
        {
          "command": "moonclicker.openWorkbench",
          "when": "viewItem == device"
        },
        {
          "command": "moonclicker.disconnect",
          "when": "viewItem == device"
        }
      ]
    },
    "keybindings": [
      {
        "command": "moonclicker.run",
        "key": "F5",
        "when": "editorFocus && resourceLangId == lua && resourceFilename == main.lua"
      },
      {
        "command": "moonclicker.stop",
        "key": "shift+F5",
        "when": "editorFocus && resourceLangId == lua && resourceFilename == main.lua"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "moonclicker-scripts",
          "title": "%viewsContainer.scripts%",
          "icon": "$(device-mobile)"
        }
      ]
    },
    "views": {
      "moonclicker-scripts": [
        {
          "id": "moonclicker.workspace",
          "name": "%view.workspace%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "moonclicker.workspace",
        "contents": "%viewsWelcome.disconnected%",
        "when": "!moonclicker.connected"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package-build",
    "package-build": "npm run compile && esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --minify && cp node_modules/jmuxer/dist/jmuxer.min.js dist/jmuxer.min.js",
    "generate": "buf generate ../proto",
    "precompile": "npm run generate",
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "pretest": "npm run compile",
    "test": "node --test out/test/**/*.test.js",
    "test:client": "node scripts/test-server.mjs",
    "package": "vsce package"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.73.0",
    "@bufbuild/protoc-gen-es": "^2.15.0",
    "@types/adm-zip": "^0.5.0",
    "@types/multicast-dns": "^7.2.4",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@types/ws": "^8.5.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "multicast-dns": "^7.2.5",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.15.0",
    "adm-zip": "^0.6.1",
    "ignore": "^7.0.12",
    "jmuxer": "^2.1.4",
    "ws": "^8.18.0"
  },
  "allowScripts": {
    "@bufbuild/buf@1.73.0": true,
    "esbuild@0.28.2": true,
    "@vscode/vsce-sign@2.1.0": true
  }
}
