{
  "name": "relc-script-workbench",
  "displayName": "ReLC Script Workbench",
  "description": "Connect VS Code to a ReLC device running Script Workbench.",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "relc.connect",
        "title": "ReLC: Connect to Device"
      },
      {
        "command": "relc.disconnect",
        "title": "ReLC: Disconnect from Device"
      },
      {
        "command": "relc.pull",
        "title": "ReLC: Pull Script Folder from Device"
      },
      {
        "command": "relc.push",
        "title": "ReLC: Push Script Folder to Device"
      },
      {
        "command": "relc.run",
        "title": "ReLC: Run Current Script on Device"
      },
      {
        "command": "relc.openMirror",
        "title": "ReLC: Open Realtime Mirror"
      },
      {
        "command": "relc.pushAndRun",
        "title": "ReLC: Push & Run"
      },
      {
        "command": "relc.runRemote",
        "title": "ReLC: Run Remote Script"
      },
      {
        "command": "relc.pullRemote",
        "title": "ReLC: Pull Remote Script"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "relc.connect",
          "when": "view == relc.deviceConnection",
          "group": "navigation"
        },
        {
          "command": "relc.disconnect",
          "when": "view == relc.deviceConnection",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "relc.push",
          "when": "view == relc.localScripts",
          "group": "inline"
        },
        {
          "command": "relc.pushAndRun",
          "when": "view == relc.localScripts",
          "group": "inline"
        },
        {
          "command": "relc.runRemote",
          "when": "view == relc.remoteScripts",
          "group": "inline"
        },
        {
          "command": "relc.pullRemote",
          "when": "view == relc.remoteScripts",
          "group": "inline"
        }
      ]
    },
    "keybindings": [
      {
        "command": "relc.pushAndRun",
        "key": "F5",
        "when": "editorFocus && resourceLangId == lua && resourceFilename == main.lua"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "relc-scripts",
          "title": "ReLC Scripts",
          "icon": "$(device-mobile)"
        }
      ]
    },
    "views": {
      "relc-scripts": [
        {
          "id": "relc.deviceConnection",
          "name": "Device Connection"
        },
        {
          "id": "relc.localScripts",
          "name": "Local Scripts"
        },
        {
          "id": "relc.remoteScripts",
          "name": "Remote Scripts"
        }
      ]
    }
  },
  "scripts": {
    "generate": "buf generate ../proto",
    "precompile": "npm run generate",
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "pretest": "npm run compile",
    "test": "node --test out/test/**/*.test.js"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.73.0",
    "@bufbuild/protoc-gen-es": "^2.15.0",
    "@types/adm-zip": "^0.5.0",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@types/ws": "^8.5.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.15.0",
    "adm-zip": "^0.6.1",
    "ws": "^8.18.0"
  },
  "allowScripts": {
    "@bufbuild/buf@1.73.0": true
  }
}
